# Copy to .env.local for a custom setup. Read by Vite at build time.
#
# Base URL of the UdaanPath API, including /api/v1. Leave unset in local
# development: the Vite dev server proxies /api/v1 to http://127.0.0.1:8000.
# In production set it to the deployed API, e.g.
# VITE_API_BASE_URL=https://<your-api>.onrender.com/api/v1
VITE_API_BASE_URL=
