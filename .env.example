# UdaanPath Backend Environment Configuration
# Copy this file to .env and adjust values for local development.

# Application
APP_NAME=UdaanPath
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
API_V1_PREFIX=/api/v1
SECRET_KEY=change_this_to_a_secure_random_string_min_32_chars_for_production
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Database
# For local PostgreSQL:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/udaanpath
# For quick local testing/demo without running PostgreSQL server:
# DATABASE_URL=sqlite:///./udaanpath.db

# Optional AI / LLM Configuration
# If ENABLE_LLM is false or GEMINI_API_KEY is empty, the platform seamlessly uses
# the robust deterministic rule-based recommendation and roadmap engine.
ENABLE_LLM=False
GEMINI_API_KEY=
LLM_MODEL=gemini-1.5-flash
LLM_TIMEOUT_SECONDS=15

# Facilitator Portal Defaults
FACILITATOR_INVITE_SECRET=demo_facilitator_secret_2026
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
